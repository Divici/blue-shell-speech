# Practice contact details — real values never enter the tree (repo is public).
NEXT_PUBLIC_PRACTICE_PHONE=410-555-0100
NEXT_PUBLIC_PRACTICE_EMAIL=hello@blueshellspeech.example

# "production" makes the build FAIL if contact details are missing or still placeholders.
# NODE_ENV cannot express this: it is "production" in the dev deployment too.
NEXT_PUBLIC_SITE_ENV=development

# Server-side only. The browser never calls the API directly (BFF boundary).
API_BASE_URL=http://localhost:8080

# Session encryption key for the provider session cookie (JWE, A256GCM).
# MUST decode to exactly 32 bytes. There is no default and no fallback — a missing key
# fails loudly rather than producing a session layer that protects nothing.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Rotating it invalidates every existing session, which is the intended behaviour.
SESSION_SECRET=replace-me-with-a-32-byte-base64url-value
